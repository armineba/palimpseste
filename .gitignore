/.runtime/
/.secrets/
/.local-artifacts/
*.pfx
*.key
auth.json
*.pem
*.pgdump
*.dump
*.env
!/ops/*.env.example
# Generated evidence only when explicitly reviewed
/evidence/private/
/deliverables/.stage-backend/
/.dream-loop/
