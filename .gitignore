# Unity transient data
/game/Library/
/game/Temp/
/game/Obj/
/game/Logs/
/game/UserSettings/
/game/Build/
/game/*.csproj
/game/*.sln
*.csproj.user
*.sln.DotSettings.user
# .NET transient data
**/bin/
**/obj/
**/bin.meta
**/obj.meta
**/TestResults/
**/__pycache__/
*.pyc
