    "signature_seed_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "description_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "sp.plan/1.0"
        },
        "description_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalog_version": {
          "const": "sp.capabilities/1.0"
        },
        "rules_profile": {
