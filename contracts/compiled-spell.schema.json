{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palimpseste.invalid/contracts/compiled-spell.schema.json",
  "title": "compiled-spell",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "sp.compiled/1.0"
    },
    "spell_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "parchment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "versions": {
      "type": "object",
      "properties": {
        "catalog": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "compiler": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "geometry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rules_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "min_client": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "catalog",
        "compiler",
        "geometry",
        "rules_profile",
        "min_client"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "drawing",
            "text_authoring",
            "fixture"
          ]
        },
        "capture_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_a": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "model_b": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "prompt_a_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "prompt_b_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "response_a_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "response_b_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        }
      },
