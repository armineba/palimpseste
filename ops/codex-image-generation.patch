+    text_registry.add(ApplyPatchHandler::new(false));
+    text_registry.add(PlanHandler);
+    let text_router = palimpseste_image_only_router(text_registry);
+    assert!(text_router.registered_tool_names_for_test().is_empty());
+    assert!(text_router.model_visible_specs().is_empty());
+    assert_eq!(text_router.tool_mode(), ToolMode::Direct);
+    assert!(!text_router.requires_code_mode_worker());
 }
 
