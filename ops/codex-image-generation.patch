+
+// A player image worker exposes and executes only the native image tool. A
+// read-only sandbox alone does not remove apply_patch or other built-in tools.
+pub(crate) fn palimpseste_image_only_router(mut registry: ToolRegistry) -> ToolRouter {
+    let allowed = ToolName::namespaced(IMAGE_GEN_NAMESPACE, IMAGEGEN_TOOL_NAME);
+    let rejected = registry
+        .entries()
+        .map(|tool| tool.runtime.tool_name())
+        .filter(|name| name != &allowed)
+        .collect::<Vec<_>>();
+    for name in rejected {
+        registry.remove(&name);
+    }
+    for tool in registry.entries_mut() {
+        tool.exposure = ToolExposure::DirectModelOnly;
+    }
+    let specs = registry.entries().map(|tool| tool.runtime.spec()).collect();
+    ToolRouter::from_parts(
+        registry,
+        specs,
+        ToolMode::Direct,
+        BTreeMap::new(),
+        None,
+        &[],
+    )
 }
 
