+    header_model: Option<String>,
+    body_model: Option<String>,
+    reasoning_effort: Option<String>,
+    conflict: bool,
+}
+
+impl ProviderResponseTracker {
+    pub(crate) fn with_header_model(model: Option<&str>) -> Self {
+        let mut tracker = Self::default();
+        Self::record(&mut tracker.header_model, model, &mut tracker.conflict);
+        tracker
+    }
+
+    fn record(slot: &mut Option<String>, value: Option<&str>, conflict: &mut bool) {
+        let Some(value) = value else {
+            return;
+        };
+        if value.trim().is_empty() {
+            *conflict = true;
+            return;
+        }
+        match slot {
+            Some(previous) if previous.as_str() != value => *conflict = true,
+            Some(_) => {}
+            None => *slot = Some(value.to_owned()),
+        }
+    }
+
+    fn record_json(slot: &mut Option<String>, value: Option<&Value>, conflict: &mut bool) {
+        match value {
+            None => {}
+            Some(Value::String(value)) => Self::record(slot, Some(value), conflict),
+            Some(_) => *conflict = true,
+        }
+    }
+
+    fn observe_headers(&mut self, headers: Option<&Value>) {
+        let Some(headers) = headers else {
+            return;
+        };
+        let Value::Object(headers) = headers else {
+            // A null header block means that no response headers were supplied.
+            if !headers.is_null() {
+                self.conflict = true;
+            }
+            return;
+        };
+        for (name, value) in headers {
+            if !name.eq_ignore_ascii_case("openai-model")
+                && !name.eq_ignore_ascii_case("x-openai-model")
+            {
+                continue;
+            }
+            match value {
+                Value::String(value) => {
+                    Self::record(&mut self.header_model, Some(value), &mut self.conflict);
+                }
+                Value::Array(items) if !items.is_empty() => {
+                    for item in items {
+                        Self::record_json(&mut self.header_model, Some(item), &mut self.conflict);
+                    }
+                }
+                _ => self.conflict = true,
+            }
+        }
+    }
+
+    pub(crate) fn observe(&mut self, event: &ResponsesStreamEvent) {
+        self.observe_headers(
+            event
+                .response
+                .as_ref()
+                .and_then(|response| response.get("headers")),
+        );
+        self.observe_headers(event.headers.as_ref());
+        if !matches!(
+            event.kind(),
+            "response.created" | "response.in_progress" | "response.completed"
+        ) {
+            return;
+        }
+        let Some(response) = event.response.as_ref() else {
+            return;
+        };
+        let id = response.get("id").and_then(Value::as_str);
+        Self::record_json(
+            &mut self.response_id,
+            response.get("id"),
+            &mut self.conflict,
+        );
+        if id.is_none() {
+            return;
+        }
+        Self::record_json(
+            &mut self.body_model,
+            response.get("model"),
+            &mut self.conflict,
+        );
+        Self::record_json(
+            &mut self.reasoning_effort,
+            response
+                .get("reasoning")
+                .and_then(|reasoning| reasoning.get("effort")),
+            &mut self.conflict,
+        );
+    }
+
+    pub(crate) fn completed(&self, response_id: &str) -> ProviderResponseMetadata {
+        let conflict = self.conflict
+            || self.response_id.as_deref() != Some(response_id)
+            || self
+                .header_model
+                .as_ref()
+                .zip(self.body_model.as_ref())
+                .is_some_and(|(header, body)| header != body);
+        if conflict {
+            return ProviderResponseMetadata {
+                conflict: true,
+                ..Default::default()
+            };
+        }
+        ProviderResponseMetadata {
+            model: self
+                .header_model
+                .clone()
+                .or_else(|| self.body_model.clone()),
+            reasoning_effort: self.reasoning_effort.clone(),
+            conflict: false,
+        }
+    }
+}
