+#[test]
+fn failed_turn_does_not_emit_attestation() {
+    let mut processor = EventProcessorWithJsonOutput::new(None);
+    processor.collect_thread_events(raw_response("r1", Some("gpt-5.6-luna"), Some("max"), false));
+    let mut failed = completed_turn();
+    if let ServerNotification::TurnCompleted(notification) = &mut failed {
+        notification.turn.status = TurnStatus::Failed;
+    }
+    let collected = processor.collect_thread_events(failed);
+    assert!(
+        !collected
+            .events
+            .iter()
+            .any(|event| matches!(event, ThreadEvent::ProviderAttested(_)))
+    );
+}
+
+#[test]
+fn compaction_then_generation_attests_both_distinct_responses() {
+    let mut processor = EventProcessorWithJsonOutput::new(None);
+    processor.collect_thread_events(raw_response(
+        "compact-r1",
+        Some("gpt-5.6-luna"),
+        Some("max"),
+        false,
+    ));
+    processor.collect_thread_events(raw_response(
+        "generation-r2",
+        Some("gpt-5.6-luna"),
+        Some("max"),
+        false,
+    ));
+    let events = processor.collect_thread_events(completed_turn()).events;
+    let ThreadEvent::ProviderAttested(attested) = &events[0] else {
+        panic!("expected compaction and generation attestation");
+    };
+    assert_eq!(attested.response_count, 2);
+    assert!(matches!(events[1], ThreadEvent::TurnCompleted(_)));
+}
+
+#[test]
+fn response_count_overflow_rejects_attestation() {
+    let mut processor = EventProcessorWithJsonOutput::new(None);
+    processor.provider_response_count = u32::MAX;
+    processor.collect_thread_events(raw_response("r1", Some("gpt-5.6-luna"), Some("max"), false));
+    let events = processor.collect_thread_events(completed_turn()).events;
+    assert_eq!(events.len(), 1);
+    assert!(matches!(events[0], ThreadEvent::TurnCompleted(_)));
+}
