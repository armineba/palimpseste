+#[test]
+fn attestation_precedes_completed_turn_and_counts_every_response() {
+    let mut processor = EventProcessorWithJsonOutput::new(None);
+    for response_id in ["r1", "r2"] {
+        let collected = processor.collect_thread_events(raw_response(
+            response_id,
+            Some("gpt-5.6-luna"),
+            Some("max"),
+            false,
+        ));
+        assert!(collected.events.is_empty());
+    }
+    let collected = processor.collect_thread_events(completed_turn());
+    assert_eq!(collected.events.len(), 2);
+    let attested = serde_json::to_value(&collected.events[0]).expect("serialize attestation");
+    assert_eq!(
+        attested,
+        json!({
+            "type": "provider.attested",
+            "source": "server_response",
+            "model": "gpt-5.6-luna",
+            "reasoning_effort": "max",
+            "response_count": 2
+        })
+    );
+    assert!(matches!(collected.events[1], ThreadEvent::TurnCompleted(_)));
+}
+
+#[test]
+fn attestation_is_absent_for_missing_or_conflicting_response_metadata() {
+    for responses in [
+        vec![raw_response("r1", Some("gpt-5.6-luna"), None, false)],
+        vec![raw_response("r1", Some("gpt-5.6-luna"), Some("max"), true)],
+        vec![
+            raw_response("r1", Some("gpt-5.6-luna"), Some("max"), false),
+            raw_response("r2", Some("gpt-5.6-sol"), Some("max"), false),
+        ],
+        vec![
+            raw_response("r1", Some("gpt-5.6-luna"), Some("max"), false),
+            raw_response("r1", Some("gpt-5.6-luna"), Some("max"), false),
+        ],
+        vec![raw_response("", Some("gpt-5.6-luna"), Some("max"), false)],
+    ] {
+        let mut processor = EventProcessorWithJsonOutput::new(None);
+        for response in responses {
+            processor.collect_thread_events(response);
+        }
+        let collected = processor.collect_thread_events(completed_turn());
+        assert_eq!(collected.events.len(), 1);
+        assert!(matches!(collected.events[0], ThreadEvent::TurnCompleted(_)));
+    }
+}
