+
+fn completed_turn() -> ServerNotification {
+    ServerNotification::TurnCompleted(codex_app_server_protocol::TurnCompletedNotification {
+        thread_id: "thread-1".to_string(),
+        turn: codex_app_server_protocol::Turn {
+            id: "turn-1".to_string(),
