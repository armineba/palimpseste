# Exemple de paramètres APPLICATIFS à implémenter dans le backend.
# Ce fichier n'est PAS une configuration Codex native et n'active rien à lui seul.
# Ne contient aucun secret. Politique D10 : interpr?tation Sol high, plan Astra high.
PALIMPSESTE_PROVIDER=codex_exec
PALIMPSESTE_INTERPRETER_MODEL=gpt-5.6-sol
PALIMPSESTE_INTERPRETER_EFFORT=high
PALIMPSESTE_PLANNER_MODEL=gpt-6-astra
PALIMPSESTE_PLANNER_EFFORT=high
PALIMPSESTE_INTERPRETER_VERIFIED=false
PALIMPSESTE_INTERPRETER_EVIDENCE_PATH=
PALIMPSESTE_INTERPRETER_EVIDENCE_SHA256=
PALIMPSESTE_EFFORT_VERIFIED=false
PALIMPSESTE_RUNTIME_FEATURES_VERIFIED=false
# Set only after the dedicated-account doctor JSON has been reviewed and hashed.
PALIMPSESTE_RUNTIME_FEATURE_EVIDENCE_PATH=
PALIMPSESTE_RUNTIME_FEATURE_EVIDENCE_SHA256=
PALIMPSESTE_EFFORT_EVIDENCE_PATH=
PALIMPSESTE_EFFORT_EVIDENCE_SHA256=
PALIMPSESTE_CODEX_EXECUTABLE=
PALIMPSESTE_CODEX_HOME=
PALIMPSESTE_ATTEMPT_ROOT=
PALIMPSESTE_CODEX_JOB_ROOT=
PALIMPSESTE_SPEC_ROOT=
PALIMPSESTE_INPUT_ROOT=
PALIMPSESTE_ARTIFACT_ROOT=
PALIMPSESTE_DEVELOPMENT_ROOT=
PALIMPSESTE_PROVIDER_EVIDENCE_ROOT=
PALIMPSESTE_SERVICE_USER=
PALIMPSESTE_PROVIDER_ATTEMPT_TIMEOUT_SECONDS=1800
PALIMPSESTE_ATTEMPT_SECONDS=1800
PALIMPSESTE_MAX_OUTPUT_BYTES=2000000
# 0 = no application ceiling on simultaneous jobs; GPU captures share one renderer slot.
PALIMPSESTE_MAX_PROVIDER_CONCURRENCY=0
# Optional operator-owned drain marker. Must be next to the protected Codex executable.
PALIMPSESTE_WORKER_DRAIN_FILE=E:\PalimpsesteRuntime\bin\worker-drain.request
PALIMPSESTE_MAX_JOB_REQUESTS=10
PALIMPSESTE_ALLOW_MODEL_FALLBACK=false
PALIMPSESTE_ALLOW_REASONING_DOWNGRADE=false
PALIMPSESTE_RUNTIME_EXECUTION_TOOLS=false
PALIMPSESTE_DEPLOYMENT_MODE=private_lab
# Les quotas/coûts autorisés doivent être configurés par l'opérateur.
# Les valeurs effectives d'effort et les chemins sont résolus puis testés au préflight.
# CODEX_HOME est un nom natif ; le runner mappe explicitement son paramètre applicatif.
# Ne jamais inclure auth.json, jetons, mots de passe ou clés dans ce fichier.
# Le fichier réel doit être écrit hors du dépôt par l'opérateur ; ces valeurs
# ne prouvent pas l'authentification ni l'acceptation des mod?les et efforts demand?s.
